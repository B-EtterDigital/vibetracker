{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeusage.c0vibe.app/schemas/vibetracker-plugin.json",
  "title": "VibeTRACKER Plugin Manifest",
  "type": "object",
  "required": ["schema", "id", "label", "version", "entry", "providers"],
  "properties": {
    "schema": { "const": "vibetracker.plugin/0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "entry": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "categories", "auth", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,62}$" },
          "categories": { "type": "array", "items": { "enum": ["llm", "coding", "image", "video", "music", "audio", "3d", "other"] } },
          "auth": { "enum": ["apiKey", "oauth", "cookie", "mcp", "localLogs", "none"] },
          "source": { "enum": ["ledger", "balance_delta", "log", "feed_recon", "proxy", "local", "manual"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
