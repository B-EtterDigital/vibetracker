# Supabase (public read for the leaderboard/profile pages)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# The ingest edge function that /api/ingest rewrites to (single-domain upload).
# Deploy it with: supabase functions deploy ingest
INGEST_EDGE_URL=https://<ref>.functions.supabase.co/ingest
