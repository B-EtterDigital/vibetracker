{
  "manifest_version": 3,
  "name": "VibeTRACKER Bridge",
  "version": "0.7.8",
  "description": "One-click connect cookie-only AI sources and read logged-in usage numbers into your local VibeTRACKER ledger. Local only.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "scripting", "cookies", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8799/*",
    "http://localhost:8799/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8123/*",
    "http://localhost:8123/*",
    "https://suno.com/*",
    "https://www.suno.com/*",
    "https://udio.com/*",
    "https://www.udio.com/*",
    "https://seaart.ai/*",
    "https://www.seaart.ai/*",
    "https://tensor.art/*",
    "https://www.tensor.art/*",
    "https://pixverse.ai/*",
    "https://app.pixverse.ai/*",
    "https://vidu.com/*",
    "https://www.vidu.com/*",
    "https://vidu.studio/*",
    "https://midjourney.com/*",
    "https://www.midjourney.com/*",
    "https://higgsfield.ai/*",
    "https://www.higgsfield.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://elevenlabs.io/*",
    "https://app.leonardo.ai/*",
    "https://leonardo.ai/*",
    "https://app.runwayml.com/*",
    "https://runwayml.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "VibeTRACKER Bridge — connect & read AI usage"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
