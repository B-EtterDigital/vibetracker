{
  "manifest_version": 3,
  "name": "VibeTRACKER Bridge",
  "version": "0.3.0",
  "description": "One-click connect cookie-only AI sources and read logged-in usage numbers into your local VibeTRACKER ledger. Local only.",
  "permissions": ["activeTab", "tabs", "scripting", "cookies"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://suno.com/*",
    "https://www.suno.com/*",
    "https://udio.com/*",
    "https://www.udio.com/*",
    "https://seaart.ai/*",
    "https://www.seaart.ai/*",
    "https://tensor.art/*",
    "https://www.tensor.art/*",
    "https://pixverse.ai/*",
    "https://app.pixverse.ai/*",
    "https://vidu.com/*",
    "https://www.vidu.com/*",
    "https://vidu.studio/*",
    "https://haiper.ai/*",
    "https://app.haiper.ai/*",
    "https://midjourney.com/*",
    "https://www.midjourney.com/*",
    "https://higgsfield.ai/*",
    "https://www.higgsfield.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://elevenlabs.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VibeTRACKER Bridge — connect & read AI usage"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
